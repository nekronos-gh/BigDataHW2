Bootstrap: docker
From: eclipse-temurin:21-jdk

%labels
    Author "OpenCode Agent"
    Version "1.0"
    Description "Apptainer image for Spark Recommender System (Problem 3)"

%environment
    export SCALA_VERSION=2.13.16
    export SPARK_VERSION=4.0.2
    export JAVA_HOME=/opt/java/openjdk
    export SCALA_HOME=/opt/scala
    export SPARK_HOME=/opt/spark
    export SBT_HOME=/opt/sbt
    export PATH=$SCALA_HOME/bin:$SPARK_HOME/bin:$SBT_HOME/bin:$PATH

%post
    export SCALA_VERSION=2.13.16
    export SPARK_VERSION=4.0.2
    export SBT_VERSION=1.10.1
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        bash curl wget tar gzip unzip python3 procps ca-certificates findutils coreutils \
        && rm -rf /var/lib/apt/lists/*

    # Install Scala
    wget -q https://www.scala-lang.org/files/archive/scala-${SCALA_VERSION}.tgz \
        && tar -xzf scala-${SCALA_VERSION}.tgz -C /opt \
        && ln -s /opt/scala-${SCALA_VERSION} /opt/scala \
        && rm scala-${SCALA_VERSION}.tgz

    # Install SBT
    wget -q https://github.com/sbt/sbt/releases/download/v${SBT_VERSION}/sbt-${SBT_VERSION}.tgz \
        && tar -xzf sbt-${SBT_VERSION}.tgz -C /opt \
        && ln -s /opt/sbt /opt/sbt-link || true \
        && rm sbt-${SBT_VERSION}.tgz

    # Install Spark
    wget -q https://downloads.apache.org/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3.tgz \
        && tar -xzf spark-${SPARK_VERSION}-bin-hadoop3.tgz -C /opt \
        && ln -s /opt/spark-${SPARK_VERSION}-bin-hadoop3 /opt/spark \
        && rm spark-${SPARK_VERSION}-bin-hadoop3.tgz

    # Setup Workspace
    mkdir -p /workspace

%files
    . /workspace

%runscript
    cd /workspace
    # Build the project at runtime
    sbt package
    exec ./run.sh
